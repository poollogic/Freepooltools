# Cloudflare Pages response headers.
# Hashed build assets + fonts never change for a given URL → cache forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is prerendered per route; let the CDN serve it but revalidate so deploys
# go live quickly.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
